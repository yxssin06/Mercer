# ── Supabase ──────────────────────────────────────────────────────────────────
# 1. Create a project at supabase.com
# 2. Run supabase/schema.sql in the SQL Editor
# 3. Go to Authentication → Settings → disable "Enable email confirmations"
# 4. Copy URL and anon key from Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── EmailJS (optional — booking/status confirmation emails) ───────────────────
# https://www.emailjs.com (free tier: 200 emails/month)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
VITE_EMAILJS_TEMPLATE_BOOKING=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_STATUS=template_xxxxxxx
